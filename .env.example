# Copy this file to ".env" and fill in what you have.
# You can ALSO set all of these inside the app on the Setup page — whichever you prefer.

# ===== AI provider =====
# Default is Claude (Anthropic). Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: use Google Gemini's free tier instead.
# 1) set PROVIDER=gemini   2) get a key: https://aistudio.google.com/apikey
# 3) install it once:  pip install google-generativeai
GEMINI_API_KEY=
PROVIDER=claude

# ===== Optional extra job source =====
# Adzuna is free and adds more remote listings: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ===== Your identity (used in cover letters + the email footer) =====
FULL_NAME=
EMAIL_ADDRESS=
PHONE=
LOCATION=Remote
LINKEDIN_URL=

# ===== Outreach safety =====
# Max recruiter emails you can draft per day (prevents spammy behavior).
OUTREACH_DAILY_CAP=15

# ===== Stealth browser (optional, free) =====
# Camoufox = open-source anti-detect Firefox used for scraping + review-first apply.
# Installed by setup.bat; binaries live in data/camoufox (D: drive).
# Set CAMOUFOX_ENABLED=0 to force the plain Chromium engine instead.
CAMOUFOX_ENABLED=1
# CAMOUFOX_INSTALL_DIR=D:\Ai job finder\data\camoufox
